# Better Auth base URL (your app URL)
BETTER_AUTH_URL="http://localhost:3000"

# Better Auth secret (replace with a strong random value in real environments)
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"

TAXTRACK_SEED_EMAIL="replace-with-seed-email"
TAXTRACK_SEED_PASSWORD="replace-with-seed-password"
TAXTRACK_SEED_NAME="TaxTrack Admin"

# S3 bucket used by the upload intake polling demo endpoint (/api/s3-events)
# AWS_PROFILE="mac-bacon-profile"
S3_BUCKET_NAME="your-bucket-name"
S3_REGION="ap-southeast-1"
S3_MAX_KEYS="20"
S3_PREFIX="optional/prefix/"


AWS_PROFILE="your-aws-profile-name"
AWS_SDK_LOAD_CONFIG=1
