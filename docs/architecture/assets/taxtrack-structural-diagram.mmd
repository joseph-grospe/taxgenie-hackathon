    classDef operations fill:#F8FAFC,stroke:#64748B,color:#0F172A,stroke-width:1.5px;
    classDef external fill:#FDF4FF,stroke:#A855F7,color:#0F172A,stroke-width:1.5px;

    class USERS,RECIPIENTS person;
    class WEB web;
    class DATA data;
