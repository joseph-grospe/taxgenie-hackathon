{
  "name": "taxgenie",
  "private": true,
  "packageManager": "pnpm@10.11.1",
  "scripts": {
    "deploy:bootstrap": "scripts/deploy-gcp-bootstrap.sh",
    "deploy:images": "scripts/build-gcp-images.sh",
    "deploy:infra": "pnpm --filter @taxgenie/infra-gcp up -- --stack prod",
    "deploy:migrate": "scripts/run-gcp-migrations.sh",
    "deploy:smoke": "scripts/smoke-gcp.sh",
    "deploy:all": "scripts/deploy-gcp.sh",
    "deploy:web": "scripts/deploy-gcp.sh",
    "deploy:worker": "scripts/deploy-gcp.sh",
    "deploy:hackathon:bootstrap": "scripts/deploy-gcp-hackathon-bootstrap.sh",
    "deploy:hackathon:images": "TAXGENIE_DEPLOYMENT_PROFILE=hackathon PULUMI_STACK=hackathon scripts/build-gcp-images.sh",
    "deploy:hackathon:infra": "PULUMI_STACK=hackathon scripts/deploy-gcp-hackathon-infra.sh",
    "deploy:hackathon:migrate": "TAXGENIE_DEPLOYMENT_PROFILE=hackathon PULUMI_STACK=hackathon scripts/run-gcp-migrations.sh",
    "deploy:hackathon:smoke": "PULUMI_STACK=hackathon scripts/smoke-gcp-hackathon.sh",
    "deploy:hackathon:preview": "PULUMI_STACK=hackathon scripts/preview-gcp-hackathon.sh",
    "deploy:hackathon:all": "scripts/deploy-gcp-hackathon.sh",
    "dev:web": "pnpm --dir webapp/tax-genie dev",
    "db:generate:web": "pnpm --dir webapp/tax-genie db:generate",
    "db:migrate:web": "pnpm --dir webapp/tax-genie db:migrate",
    "dev:worker": "pnpm --filter @taxgenie/worker dev",
    "dev:merge-worker": "pnpm --filter @taxgenie/merge-worker dev",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test"
  }
}
