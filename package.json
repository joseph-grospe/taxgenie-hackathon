{
  "name": "extract-bir-2307",
  "private": true,
  "packageManager": "pnpm@10.11.1",
  "scripts": {
    "deploy:web": "scripts/deploy-taxtrack.sh web",
    "deploy:backend": "scripts/deploy-taxtrack.sh backend",
    "deploy:all": "scripts/deploy-taxtrack.sh all",
    "dev:web": "pnpm --dir webapp/tax-track dev",
    "dev:worker": "pnpm --filter @taxtrack/worker dev",
    "dev:worker:test-event": "pnpm --filter @taxtrack/worker dev:emit-test-event",
    "dev:lambda": "pnpm --filter @taxtrack/infra sst dev",
    "build:lambda": "pnpm --filter @taxtrack/lambda build",
    "sst:dev": "pnpm --filter @taxtrack/infra exec sst dev",
    "sst:deploy:dev": "pnpm --filter @taxtrack/infra exec sst deploy --stage dev",
    "sst:deploy:dev:minimal": "TAXTRACK_INFRA_PROFILE=localdev pnpm --filter @taxtrack/infra exec sst deploy --stage dev",
    "sst:deploy:prod": "pnpm --filter @taxtrack/infra exec sst deploy --stage prod",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test"
  }
}
