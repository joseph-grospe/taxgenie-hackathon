# Cloud Run runtime contract. Pulumi injects these values; secrets come from
# Secret Manager and must not be committed.
NODE_ENV=production
PORT=8080
GCP_PROJECT_ID=<project-id>
GCP_REGION=asia-southeast1
INSTANCE_UNIX_SOCKET=/cloudsql/<project-id>:asia-southeast1:taxgenie-prod-postgres
DB_NAME=taxgenie
DB_USER=taxgenie_app
DB_PASSWORD=<secret-manager-reference>

STORAGE_BUCKET_NAME=<project-id>-taxgenie-production
STORAGE_OBJECT_PREFIX=v2
CLOUD_TASKS_QUEUE_ID=document-extraction
WORKER_SERVICE_URL=https://<private-worker-service-url>
TASK_INVOKER_SERVICE_ACCOUNT=<task-invoker-service-account>
WORKER_CLAIM_LEASE_SECONDS=600

BETTER_AUTH_SECRET=<secret-manager-reference>
BETTER_AUTH_URL=https://taxgenie.online
TAXGENIE_SEED_EMAIL=<secret-manager-reference>
TAXGENIE_SEED_PASSWORD=<secret-manager-reference>
TAXGENIE_SEED_NAME=TaxGenie Admin
TAXGENIE_ENABLE_MERGE=false
TAXGENIE_ENABLE_OUTBOUND_EMAIL=false
TAXGENIE_ENABLE_PURGE=false

GEMINI_API_KEY=<secret-manager-reference>
GEMINI_MODEL=gemini-3.5-flash
GEMINI_THINKING_LEVEL=high
GEMINI_MEDIA_RESOLUTION=medium
GEMINI_TIMEOUT_MS=180000
SIGNATURE_VISUAL_DETECTOR_ENABLED=true
SIGNATURE_VISUAL_MIN_CONFIDENCE=0.86
SIGNATURE_VISUAL_DPI=400
SIGNATURE_VISUAL_TIMEOUT_MS=60000
PDF_TEXT_LAYER_FALLBACK_ENABLED=true
PAYOR_SIGNER_VERIFICATION_ENABLED=false
IDENTITY_CONFIDENCE_FLOW_ENABLED=true

TAXGENIE_LANGSMITH_ENABLED=false
LANGSMITH_API_KEY=<optional-secret-manager-reference>
LANGSMITH_ENDPOINT=https://apac.api.smith.langchain.com
LANGSMITH_PROJECT=taxgenie-production
LANGCHAIN_CALLBACKS_BACKGROUND=true
