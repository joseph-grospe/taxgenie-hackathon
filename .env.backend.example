AWS_REGION=ap-southeast-1
DATABASE_URL=postgresql://taxtrack:<db-password>@<rds-host>:5432/<db-name>
ELECTRICSQL_URL=http://localhost:5133
SQS_QUEUE_URL=<sqs-queue-url>
SQS_DLQ_URL=<sqs-dlq-url>
S3_BUCKET=<s3-artifacts-bucket>
WEBHOOK_URL=<api-gateway-url>
DRIVE_WEBHOOK_SECRET=<webhook-secret>
ADMIN_TOKEN=<worker-admin-token>
WORKER_CONCURRENCY=2
SQS_WAIT_TIME_SECONDS=20
SQS_VISIBILITY_TIMEOUT_SECONDS=300
LANGFUSE_ENABLED=true
LANGFUSE_HOST=http://localhost:3001
LANGFUSE_PUBLIC_KEY=<langfuse-public-key>
LANGFUSE_SECRET_KEY=<langfuse-secret-key>
