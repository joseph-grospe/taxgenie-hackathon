FROM node:22.14-bookworm-slim AS runtime

WORKDIR /workspace
RUN corepack enable && corepack prepare pnpm@10.11.1 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY backend/shared/package.json backend/shared/package.json
COPY backend/worker/package.json backend/worker/package.json
RUN pnpm install --frozen-lockfile

COPY backend/shared backend/shared
COPY backend/worker backend/worker
RUN pnpm --filter @taxgenie/worker typecheck

ENV NODE_ENV=production \
    PORT=8080
WORKDIR /workspace/backend/worker
USER node
EXPOSE 8080
CMD ["node", "--import", "tsx", "src/app.ts"]
