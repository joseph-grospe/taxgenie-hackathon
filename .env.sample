# Local TaxGenie development. Production values are injected by Cloud Run and
# Secret Manager; do not place production credentials in this file.
NODE_ENV=development
PORT=8080
DATABASE_URL=postgresql://taxgenie:taxgenie@localhost:5432/taxgenie

GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=asia-southeast1
STORAGE_BUCKET_NAME=your-local-development-bucket
STORAGE_OBJECT_PREFIX=v2
CLOUD_TASKS_QUEUE_ID=document-extraction
WORKER_SERVICE_URL=http://localhost:8081
TASK_INVOKER_SERVICE_ACCOUNT=taxgenie-task-invoker@your-gcp-project-id.iam.gserviceaccount.com

BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
TAXGENIE_SEED_EMAIL=admin@example.com
TAXGENIE_SEED_PASSWORD=replace-with-a-strong-password
TAXGENIE_SEED_NAME=TaxGenie Admin

TAXGENIE_ENABLE_MERGE=true
TAXGENIE_ENABLE_OUTBOUND_EMAIL=true
TAXGENIE_ENABLE_PURGE=true
VITE_TAXGENIE_ENABLE_MERGE=true
VITE_TAXGENIE_ENABLE_OUTBOUND_EMAIL=true
VITE_TAXGENIE_ENABLE_PURGE=true

WORKER_CLAIM_LEASE_SECONDS=600
GEMINI_API_KEY=replace-me
GEMINI_MODEL=gemini-3.5-flash
GEMINI_THINKING_LEVEL=high
GEMINI_MEDIA_RESOLUTION=medium
GEMINI_TIMEOUT_MS=180000
SIGNATURE_VISUAL_DETECTOR_ENABLED=true
SIGNATURE_VISUAL_MIN_CONFIDENCE=0.86
SIGNATURE_VISUAL_DPI=400
SIGNATURE_VISUAL_TIMEOUT_MS=60000
PDF_TEXT_LAYER_FALLBACK_ENABLED=true
PAYOR_SIGNER_VERIFICATION_ENABLED=false
IDENTITY_CONFIDENCE_FLOW_ENABLED=true

TAXGENIE_LANGSMITH_ENABLED=false
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://apac.api.smith.langchain.com
LANGSMITH_PROJECT=taxgenie-dev
LANGCHAIN_CALLBACKS_BACKGROUND=true
