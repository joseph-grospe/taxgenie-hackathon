AWS_REGION=ap-southeast-1
AWS_PROFILE=mac-bacon-profile
SST_STAGE=dev
TAXTRACK_INFRA_PROFILE=localdev
TAXTRACK_INFRA_SCOPE=all # options: all | backend | web
TAXTRACK_WEBHOOK_SECRET=replace-me
TAXTRACK_WORKER_ADMIN_TOKEN=replace-me
TAXTRACK_DB_PASSWORD=replace-me
WORKER_ECR_REPOSITORY=<account>.dkr.ecr.ap-southeast-1.amazonaws.com/<worker-repo>
TAXTRACK_WORKER_IMAGE_URI=replace-me
TAXTRACK_ELECTRICSQL_IMAGE_URI=replace-me

BETTER_AUTH_SECRET=replace-me
BETTER_AUTH_URL=https://<your-cloudfront-or-domain>
TAXTRACK_SEED_EMAIL=replace-me
TAXTRACK_SEED_PASSWORD=replace-me
TAXTRACK_SEED_NAME=TaxTrack Admin

WORKER_PORT=3002

S3_REGION=ap-southeast-1
S3_BUCKET_NAME=<source-files-bucket-name>
S3_PREFIX=
S3_MAX_KEYS=100

DATABASE_URL=postgresql://taxtrack:password@localhost:5432/taxtrack
SQS_QUEUE_URL=https://sqs.ap-southeast-1.amazonaws.com/202128604126/taxtrack-events-dev
SQS_DLQ_URL=https://sqs.ap-southeast-1.amazonaws.com/202128604126/taxtrack-events-dlq-dev
S3_BUCKET=<artifacts-bucket-name>
WORKER_TEST_S3_BUCKET=<source-or-artifacts-bucket-for-testing>
WORKER_TEST_QUEUE_URL=https://sqs.ap-southeast-1.amazonaws.com/202128604126/taxtrack-events-worker-test-dev
WEBHOOK_URL=https://<api-id>.execute-api.ap-southeast-1.amazonaws.com
DRIVE_WEBHOOK_SECRET=replace-me
ADMIN_TOKEN=replace-me
WORKER_CONCURRENCY=2
SQS_WAIT_TIME_SECONDS=20
SQS_VISIBILITY_TIMEOUT_SECONDS=300

# Mistral Document AI (Azure Foundry OCR)
# Use either MISTRAL_API_KEY or AZURE_API_KEY from your Azure Foundry deployment
MISTRAL_API_KEY=replace-me
AZURE_API_KEY=
MISTRAL_API_URL=https://taxtrack.services.ai.azure.com/providers/mistral/azure/ocr
MISTRAL_MODEL=mistral-document-ai-2505
MISTRAL_TIMEOUT_MS=60000

# Azure OpenAI (normalizer)
AZURE_OPENAI_API_KEY=<azure-openai-api-key>
AZURE_OPENAI_ENDPOINT=https://taxtrack.cognitiveservices.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4.1
AZURE_OPENAI_API_VERSION=2024-04-01-preview
AZURE_OPENAI_TIMEOUT_MS=60000

# Langfuse keys for local worker runtime:
LANGFUSE_ENABLED=true
LANGFUSE_HOST=http://localhost:3001
LANGFUSE_PUBLIC_KEY=pk-lf-local
LANGFUSE_SECRET_KEY=sk-lf-local

# Backward-compatible/infra aliases (also accepted by infra tooling and app fallback logic):
# Keep these in sync with LANGFUSE_* when set.
TAXTRACK_LANGFUSE_ENABLED=true
TAXTRACK_LANGFUSE_HOST=http://localhost:3001
TAXTRACK_LANGFUSE_PUBLIC_KEY=pk-lf-local
TAXTRACK_LANGFUSE_SECRET_KEY=sk-lf-local
TAXTRACK_LANGFUSE_SALT=replace-me

ELECTRICSQL_URL=http://localhost:5133
