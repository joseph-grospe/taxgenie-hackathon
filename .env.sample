AWS_REGION=ap-southeast-1
AWS_PROFILE=mac-bacon-profile
SST_STAGE=dev
TAXTRACK_INFRA_PROFILE=localdev
TAXTRACK_INFRA_SCOPE=all # options: all | backend | web
TAXTRACK_WEBHOOK_SECRET=replace-me
TAXTRACK_WORKER_ADMIN_TOKEN=replace-me
TAXTRACK_DB_PASSWORD=replace-me
TAXTRACK_WORKER_IMAGE_URI=replace-me
TAXTRACK_ELECTRICSQL_IMAGE_URI=replace-me
TAXTRACK_LANGFUSE_PUBLIC_KEY=replace-me
TAXTRACK_LANGFUSE_SECRET_KEY=replace-me
TAXTRACK_LANGFUSE_SALT=replace-me
TAXTRACK_LANGFUSE_HOST=http://localhost:3001

BETTER_AUTH_SECRET=replace-me
BETTER_AUTH_URL=https://<your-cloudfront-or-domain>
TAXTRACK_SEED_EMAIL=replace-me
TAXTRACK_SEED_PASSWORD=replace-me
TAXTRACK_SEED_NAME=TaxTrack Admin

WORKER_PORT=3002

S3_REGION=ap-southeast-1
S3_BUCKET_NAME=<source-files-bucket-name>
S3_PREFIX=
S3_MAX_KEYS=100

DATABASE_URL=postgresql://taxtrack:password@localhost:5432/taxtrack
SQS_QUEUE_URL=https://sqs.ap-southeast-1.amazonaws.com/202128604126/taxtrack-events-dev
SQS_DLQ_URL=https://sqs.ap-southeast-1.amazonaws.com/202128604126/taxtrack-events-dlq-dev
S3_BUCKET=<artifacts-bucket-name>
WORKER_TEST_S3_BUCKET=<source-or-artifacts-bucket-for-testing>
WORKER_TEST_QUEUE_URL=https://sqs.ap-southeast-1.amazonaws.com/202128604126/taxtrack-events-worker-test-dev
