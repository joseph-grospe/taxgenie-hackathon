DRIVE_WEBHOOK_SECRET=replace-me
ADMIN_TOKEN=replace-me
WORKER_CONCURRENCY=2
SQS_WAIT_TIME_SECONDS=20
SQS_VISIBILITY_TIMEOUT_SECONDS=300
LANGFUSE_ENABLED=true
LANGFUSE_HOST=http://localhost:3001
