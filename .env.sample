AWS_REGION=ap-southeast-1
AWS_PROFILE=mac-bacon-profile
SST_STAGE=dev
TAXGENIE_INFRA_PROFILE=localdev
TAXGENIE_INFRA_SCOPE=all # options: all | backend | web
TAXGENIE_WEB_DOMAIN=dev.taxgenie.online
TAXGENIE_DOMAIN_HOSTED_ZONE_ID=
TAXGENIE_WORKER_COUNT=1 # allowed: 1 (single worker) | 2 (multi-worker)
TAXGENIE_WORKER_ADMIN_TOKEN=replace-me
TAXGENIE_DB_PASSWORD=replace-me
TAXGENIE_DB_TUNNEL_INSTANCE_ID=
TAXGENIE_DB_TUNNEL_HOST=
TAXGENIE_DB_TUNNEL_LOCAL_PORT=15432
TAXGENIE_DB_TUNNEL_REMOTE_PORT=5432
WORKER_ECR_REPOSITORY=<account>.dkr.ecr.ap-southeast-1.amazonaws.com/<worker-repo>
TAXGENIE_WORKER_IMAGE_URI=replace-me
TAXGENIE_WORKER_IMAGE_SOURCE_HASH=
MERGE_WORKER_ECR_REPOSITORY=<account>.dkr.ecr.ap-southeast-1.amazonaws.com/<merge-worker-repo>
TAXGENIE_MERGE_WORKER_IMAGE_URI=replace-me
TAXGENIE_MERGE_WORKER_IMAGE_SOURCE_HASH=
MERGE_JOBS_SKIP_AWS_BATCH=false

BETTER_AUTH_SECRET=replace-me
BETTER_AUTH_URL=https://<your-cloudfront-or-domain>
TAXGENIE_SEED_EMAIL=replace-me
TAXGENIE_SEED_PASSWORD=replace-me
TAXGENIE_SEED_NAME=TaxGenie Admin
SES_FROM_EMAIL=notifications@taxgenie.online

WORKER_PORT=3002

S3_REGION=ap-southeast-1
S3_BUCKET_NAME=<source-files-bucket-name>
S3_SOURCE_BUCKET_NAME=<source-files-bucket-name>
S3_RESULTS_BUCKET_NAME=<artifacts-bucket-name>
S3_PREFIX=
S3_MAX_KEYS=100
BATCH_RETENTION_FUNCTION_NAME=<batch-retention-lambda-name>
BATCH_RETENTION_FUNCTION_ARN=<batch-retention-lambda-arn>

DATABASE_URL=postgresql://taxgenie:password@localhost:5432/taxgenie
SQS_QUEUE_URL=https://sqs.ap-southeast-1.amazonaws.com/202128604126/taxgenie-events-dev
SQS_DLQ_URL=https://sqs.ap-southeast-1.amazonaws.com/202128604126/taxgenie-events-dlq-dev
S3_BUCKET=<artifacts-bucket-name>
ADMIN_TOKEN=replace-me
WORKER_CONCURRENCY=2
SQS_WAIT_TIME_SECONDS=20
SQS_VISIBILITY_TIMEOUT_SECONDS=300

# Gemini whole-document agent extraction
GEMINI_API_KEY=replace-me
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_THINKING_LEVEL=high
GEMINI_MEDIA_RESOLUTION=medium
GEMINI_TIMEOUT_MS=180000
SIGNATURE_VISUAL_DETECTOR_ENABLED=true
SIGNATURE_VISUAL_MIN_CONFIDENCE=0.86
SIGNATURE_VISUAL_DPI=400
SIGNATURE_VISUAL_TIMEOUT_MS=60000
PDF_TEXT_LAYER_FALLBACK_ENABLED=true
PAYOR_SIGNER_VERIFICATION_ENABLED=false
IDENTITY_CONFIDENCE_FLOW_ENABLED=true

# LangSmith Cloud tracing is disabled locally unless explicitly enabled.
TAXGENIE_LANGSMITH_ENABLED=false
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://apac.api.smith.langchain.com
LANGSMITH_PROJECT=taxgenie-dev
LANGCHAIN_CALLBACKS_BACKGROUND=true

# Deployment tooling reads the service key from this secret alias.
TAXGENIE_LANGSMITH_API_KEY=replace-me
TAXGENIE_LANGSMITH_ENDPOINT=https://apac.api.smith.langchain.com
