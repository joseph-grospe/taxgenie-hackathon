FROM node:22.14-bookworm-slim AS runtime

WORKDIR /workspace
RUN corepack enable && corepack prepare pnpm@10.11.1 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY backend/shared/package.json backend/shared/package.json
COPY webapp/tax-genie/package.json webapp/tax-genie/package.json
RUN pnpm install --frozen-lockfile

COPY backend/shared backend/shared
COPY webapp/tax-genie webapp/tax-genie

ENV NODE_ENV=production
WORKDIR /workspace/webapp/tax-genie
USER node
CMD ["node", "--import", "tsx", "scripts/migrate-and-seed.ts"]
