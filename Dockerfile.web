FROM node:22.14-bookworm-slim AS runtime

ENV NODE_ENV=production \
    HOST=0.0.0.0 \
    PORT=8080
WORKDIR /app
COPY --chown=node:node webapp/tax-genie/cloud-run.package.json ./package.json
RUN npm install --omit=dev --ignore-scripts --no-audit --no-fund --package-lock=false
COPY --chown=node:node webapp/tax-genie/.output ./
USER node
EXPOSE 8080
CMD ["node", "server/index.mjs"]
